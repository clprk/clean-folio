---
import Layout from '../layouts/Base.astro';
import { sanityClient } from 'sanity:client';
import { urlFor, aboutQuery } from '../lib/sanity';
import PortableTextRenderer from '../components/PortableTextRenderer.astro';

const about = await sanityClient.fetch(aboutQuery);

interface Experience {
  company: string;
  role: string;
  dates: string;
  description: string;
}

// can't decide if lg or xl as hero breakpoint looks better!!!
const breakpoint = 'lg';

// image url
const profileImageUrl = about.profileImage
  ? urlFor(about.profileImage)?.width(1600).height(900).url()
  : null;
---

<Layout>
  <!-- hero -->
  <section>
    <div class="container-custom my-20 flex flex-col gap-6 lg:my-30 lg:min-h-screen">
      <!-- top -->
      <div class="row-span-1 grid min-h-0 grid-rows-2 items-end gap-6">
        <!-- header -->
        <div data-reveal class="mb-2 grid grid-cols-2 gap-6 lg:mb-10">
          <div></div>
          <h1>{about.header}</h1>
        </div>
        <!-- details -->
        <div data-reveal class="tiny-text grid grid-cols-4 gap-6">
          <p>{about.leftText}</p>
          <div></div>
          <p>{about.centerText}</p>
          <p class="justify-self-end lg:justify-self-start">{about.rightText}</p>
        </div>
      </div>
      <!-- bottom -->
      <div class="grid min-h-0 grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        <!-- img -->
        <div data-reveal class="img-container col-span-1 aspect-[5/3] w-full lg:col-span-3">
          <img src={profileImageUrl} class="h-full w-full object-cover object-center" />
        </div>
        <!-- paragraph -->
        <div data-reveal class="col-span-1 flex flex-col justify-between gap-10 text-sm">
          <div class="flex flex-col gap-4">
            {Array.isArray(about.summary) && <PortableTextRenderer value={about.summary} />}
          </div>
          <div class="md:hidden lg:block">
            <p class="tiny-text mb-2">Current Favorites:</p>
            {about.favorites.map((f: String) => <p>{f}</p>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section class="container-custom flex flex-col gap-8 md:gap-24">
    <!-- <h2>✦ Experience</h2> -->
    <div data-reveal class="flex flex-col gap-10">
      {
        about.experience.map((e: any) => (
          <div class="border-light flex flex-col justify-between gap-4 border-t pt-4 md:flex-row">
            <div class="flex flex-col gap-4">
              <p class="small-text">{e.company}</p>
              <h4>{e.role}</h4>
              {e.description && <p class="small-text">{e.description}</p>}
            </div>
            <p class="small-text">{e.dates}</p>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
