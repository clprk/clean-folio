---
import Layout from '../../layouts/Base.astro';
import { sanityClient } from 'sanity:client';
import PortableTextRenderer from '../../components/PortableTextRenderer.astro';
import { urlFor, slugQuery } from '../../lib/sanity';
import slugify from 'slugify';

// fetch current and next work data
const { work, allWorks } = await sanityClient.fetch(slugQuery, Astro.params);

// generate static paths for all works
export async function getStaticPaths() {
  const SLUGS_QUERY = `*[_type == "work" && defined(slug.current)]{
    "params": {"slug": slug.current}
  }`;
  return await sanityClient.fetch(SLUGS_QUERY);
}

// find next work
const currentIndex = allWorks.findIndex((w: any) => w.slug === Astro.params['slug']);
const nextWork = currentIndex !== -1 ? allWorks[(currentIndex + 1) % allWorks.length] : null;

// image url
const workImageUrl = work.image ? urlFor(work.image)?.width(1600).height(900).url() : null;

// heading sections
type Heading = { slug: string; number: string; title: string };

const headings =
  work.body
    ?.filter((block: any) => block._type === 'textBlock' && block.header)
    .map((block: any, index: number) => {
      const slug = slugify(block.heading || `section-${index}`, {
        lower: true,
        strict: true,
      });

      return {
        title: block.heading,
        slug,
        number: String(index + 1).padStart(2, '0'),
      };
    }) || [];

// grid classes
const colMap: Record<string, string> = {
  '2': 'grid-cols-1 md:grid-cols-2',
  '3': 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
  '4': 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4',
};
---

<Layout>
  <section class=".container-custom-wrapper relative">
    <!-- toc -->
    {
      headings.length > 0 && (
        <aside class="sticky top-16 z-100 hidden h-0 w-max px-2 md:px-4 lg:block">
          <nav>
            <ul class="tiny-text space-y-3 xl:text-base">
              <li class="mb-6">
                <a href="/" class="flex items-end">
                  <span class="mr-4 font-sans text-base not-italic">←</span>
                  Home
                </a>
              </li>
              <li>
                <a href="#overview">
                  {/* <span class="text-accent mr-2">00</span> */}
                  Overview
                </a>
              </li>
              {headings.map((h: Heading) => (
                <li>
                  <a href={`#${h.slug}`}>
                    {/* <span class="text-accent mr-2">{h.number}</span> */}
                    {h.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }

    <!-- hero section -->
    <section id="overview" class="container-custom-small">
      <!-- tags -->
      <div data-reveal class="flex items-center gap-2 py-3">
        {
          work.tags?.map((tag: string, i: number) => (
            <span class="tiny-text">
              {tag}
              {i < work.tags.length - 1 && '✦'}
            </span>
          ))
        }
      </div>
      <div data-reveal>
        <!-- headline + details -->
        <div class="border-light grid grid-cols-1 border-t lg:grid-cols-2">
          <!-- headline -->
          <div class="border-light py-10 pr-3 lg:col-span-1 lg:border-r">
            <h1>{work.headline}</h1>
          </div>

          <!-- summary -->
          <div class="flex flex-col gap-5 py-6 pl-3 text-sm lg:col-span-1">
            <div>
              <p class="tiny-text mb-1">Summary</p>
              <p>{Array.isArray(work.summary) && <PortableTextRenderer value={work.summary} />}</p>
            </div>
          </div>
        </div>
        <!-- details -->
        <div
          class="border-light flex grid grid-cols-1 justify-between border-t text-sm md:grid-cols-2"
        >
          <!-- company -->
          <div class="border-light py-6 pr-3 lg:border-r">
            <p class="tiny-text mb-1">Company</p>
            <p>{work.title}</p>
          </div>
          <!-- role + timeline -->
          <div class="grid grid-cols-2 gap-3 pb-6 md:py-6 lg:pl-3">
            <div>
              <p class="tiny-text mb-1">Role</p>
              <div>{work.role?.map((r: string) => <p>{r}</p>)}</div>
            </div>
            <div>
              <p class="tiny-text mb-1">Timeline</p>
              <p>{work.timeline}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- hero image -->
      <!-- <div data-reveal class="img-container mt-6 h-[50vh] w-full overflow-hidden"> -->
      <div data-reveal class="img-container mt-6 w-full">
        {
          work.video ? (
            <video autoplay loop muted playsinline class="w-full">
              <source
                src={work.video || ''}
                type="video/mp4"
                style="filter: grayscale(15%) contrast(1.05);"
              />
            </video>
          ) : (
            <img
              src={workImageUrl || ''}
              alt={work.image?.alt || ''}
              class="h-full w-full object-cover"
              style="filter: grayscale(15%) contrast(1.05);"
            />
          )
        }
      </div>
    </section>

    <!-- body sections -->
    <section class="mt-20 flex flex-col gap-20">
      {
        work.body?.map((block: any) => {
          const isDark = block.dark;
          const isHeader = block.header;
          const hasHeading = !!block.heading;

          const containerClass = [isDark ? 'bg-dark py-20 text-white' : '', isHeader ? 'mt-10' : '']
            .filter(Boolean)
            .join(' ');

          const headerRowClass = [
            isDark ? 'text-white' : 'text-dark',
            isHeader ? 'mb-2 flex items-start gap-6' : 'grid grid-cols-1 gap-10 md:grid-cols-12',
          ].join(' ');

          const headingEntry = isHeader
            ? headings.find((h: Heading) => h.title === block.heading)
            : null;
          const num = headingEntry?.number ?? null;

          /* TEXT BLOCK */
          if (block._type === 'textBlock') {
            return (
              <div data-reveal class={containerClass}>
                <div class="container-custom-small">
                  {isHeader && <hr class="border-light mb-6" />}

                  {isHeader ? (
                    /* HEADER STYLE TEXT BLOCK */
                    <>
                      <div class={headerRowClass}>
                        <span class="text-accent small-text mt-1 leading-none">{num}</span>
                        {hasHeading && (
                          <h2
                            id={slugify(block.heading || '', { lower: true, strict: true })}
                            class="scroll-mt-32 leading-none"
                          >
                            {block.heading}
                          </h2>
                        )}
                      </div>

                      {block.content && <PortableTextRenderer value={block.content} />}
                    </>
                  ) : (
                    /* STANDARD TEXT BLOCK */

                    <div class={headerRowClass}>
                      {hasHeading && (
                        <div class="md:col-span-3">
                          <h3 class={isDark ? 'text-white' : 'text-dark'}>{block.heading}</h3>
                        </div>
                      )}

                      {block.content && (
                        <div
                          class={[
                            hasHeading ? 'md:col-span-9' : 'md:col-span-12',
                            isDark ? 'text-white' : 'text-gray',
                          ]
                            .filter(Boolean)
                            .join(' ')}
                        >
                          <PortableTextRenderer value={block.content} />
                        </div>
                      )}
                    </div>
                  )}
                </div>
              </div>
            );

            /* IMAGE BLOCK */
          } else if (block._type === 'imageBlock') {
            const isVideo = block.mediaType === 'video';
            const imageUrl =
              !isVideo && block.image ? urlFor(block.image)?.width(1200).url() : null;
            const videoUrl = isVideo ? block.video : null;

            return (
              <div data-reveal class="container-custom-small">
                <div class={headerRowClass}>
                  {block.heading && <h3 class="md:col-span-12">{block.heading}</h3>}
                </div>

                <figure>
                  <div class="img-container">
                    {isVideo ? (
                      <video autoplay loop muted playsinline class="w-full">
                        <source src={videoUrl} />
                      </video>
                    ) : imageUrl ? (
                      <img src={imageUrl} alt={block.image?.alt || ''} class="w-full" />
                    ) : null}
                  </div>
                  {block.caption && <figcaption>{block.caption}</figcaption>}
                </figure>
              </div>
            );

            /* GRID BLOCK */
          } else if (block._type === 'gridBlock') {
            return (
              <div data-reveal class="container-custom-small">
                <div class={headerRowClass}>
                  {block.heading && <h3 class="md:col-span-12">{block.heading}</h3>}
                </div>

                {/* <hr class='border-light mb-6' /> */}

                {/* grid */}
                <div class={`grid gap-12 md:gap-4 ${colMap[block.columns] || 'grid-cols-1'}`}>
                  {block.items?.map((item: any) => (
                    // grid item
                    <div>
                      {item.subtitle && <p class="small-text mb-4">{item.subtitle}</p>}

                      {item.type === 'image' && item.image && (
                        <figure>
                          <div class="img-container">
                            <img
                              src={urlFor(item.image)?.width(600).url() || ''}
                              alt={item.image.alt || ''}
                              class="w-full"
                            />
                          </div>
                          {item.caption && <figcaption>{item.caption}</figcaption>}
                        </figure>
                      )}

                      {item.type === 'video' && item.video && (
                        <div class="img-container">
                          <video autoplay loop muted playsinline class="w-full">
                            <source src={item.video} />
                          </video>
                          {/* <video autoplay loop muted playsinline class="w-full">
                            <source
                              src={item.video || ''}
                              type="video/mp4"
                              style="filter: grayscale(15%) contrast(1.05);"
                            />
                          </video> */}
                        </div>
                      )}
                      {item.type === 'video' && item.caption && (
                        <figcaption>{item.caption}</figcaption>
                      )}

                      {item.type === 'text' && item.content && (
                        // block body
                        <div>
                          <PortableTextRenderer value={item.content} />
                          {item.caption && <p class="mt-4 text-left">{item.caption}</p>}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            );
          }

          return null;
        })
      }
      <!-- next work section -->
      {
        nextWork && (
          <section data-reveal class="container-custom-small mt-10">
            <div class="border-light flex items-center justify-between gap-6 border-t pt-6">
              <div>
                <p class="tiny-text mb-2">Next Project</p>
                <a href={`/works/${nextWork.slug}`} class="group inline-block">
                  <h2 class="transition-transform group-hover:translate-x-2">
                    {nextWork.headline}
                  </h2>
                </a>
              </div>

              <div class="">→</div>
            </div>
          </section>
        )
      }
    </section>
  </section>
</Layout>
